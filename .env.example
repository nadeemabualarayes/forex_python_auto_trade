# Copy to .env (gitignored) and fill in. Real environment variables override these.
TELEGRAM_TOKEN=123456789:replace-with-token-from-BotFather
TELEGRAM_CHAT_ID=replace-with-your-chat-id
# Own terminal + account for this instance (all optional; empty = default terminal, current account).
# The bot refuses to trade if the terminal ends up on a different login than MT5_LOGIN.
MT5_PATH=C:/Develompent/mt5_scalp/terminal64.exe
MT5_LOGIN=12345678
MT5_PASSWORD=replace-with-the-account-password
MT5_SERVER=MetaQuotes-Demo
MT5_PORTABLE=1
